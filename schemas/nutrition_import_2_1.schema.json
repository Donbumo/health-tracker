          ]
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "source_food_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "maxLength": 200
        },
        "preparation": {
