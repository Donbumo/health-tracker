{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/portable_medical_documents_metadata.schema.json",
  "title": "Portable medical document metadata record v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "revision", "data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "medical_documents_metadata"},
    "public_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["study_public_id", "document_type", "filename", "mime_type", "size_bytes", "sha256", "availability", "attachment_public_id", "source"],
      "properties": {
        "study_public_id": {"type": "string", "format": "uuid"},
        "document_type": {"enum": ["original", "supporting", "medical_json", "controlled_csv"]},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "mime_type": {"enum": ["application/pdf", "image/jpeg", "image/png", "application/json", "text/csv"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "availability": {"enum": ["available", "metadata_only", "missing"]},
        "attachment_public_id": {"type": ["string", "null"], "format": "uuid"},
        "source": {"enum": ["manual", "imported", "portable_import"]}
      }
    }
  }
}
