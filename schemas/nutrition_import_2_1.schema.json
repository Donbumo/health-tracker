{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/nutrition_import_2_1.schema.json",
  "title": "Reviewed nutrition import 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "user_id",
    "source_type",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "type": {
      "const": "nutrition_import"
    },
    "user_id": {
      "type": "integer",
      "minimum": 1
    },
    "source_type": {
      "const": "uploaded"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_sha256",
        "event_key",
        "destination",
        "entries"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "destination": {
          "enum": [
            "plan",
            "consumed",
            "products",
            "recipes",
            "daily_aggregate"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bindings",
              "declaration",
              "composition",
              "evidence",
              "confirmed"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "planned_for": {
                "type": "string",
                "maxLength": 100
              },
              "meal_type": {
                "enum": [
                  "breakfast",
                  "lunch",
                  "dinner",
                  "snack",
                  "other"
                ]
              },
              "bindings": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "amount",
                    "unit"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^(catalog|user):[a-f0-9-]{36}$"
                    },
                    "food_revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
                    },
                    "unit": {
                      "enum": [
                        "g",
                        "ml",
                        "serving"
                      ]
                    },
                    "serving_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "new_food": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "nutrition"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "brand": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 200
                        },
                        "nutrition": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "nutrients": {
                              "$ref": "#/$defs/vector"
                            },
                            "servings": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/serving"
                              },
                              "maxItems": 100
                            },
                            "density_g_ml": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
                                  "maxLength": 80
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "basis_amount": {
                              "type": "string",
                              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
                            },
                            "basis_unit": {
                              "enum": [
                                "g",
                                "ml"
                              ]
                            },
                            "barcode": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 32
                            },
                            "metadata": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "aliases": {
                                  "type": "array",
                                  "maxItems": 100,
                                  "items": {
                                    "type": "string",
                                    "maxLength": 1000
                                  }
                                },
                                "brand": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "maxLength": 200
                                },
                                "barcode": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "maxLength": 32
                                },
                                "food_type": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "maxLength": 64
                                },
                                "preparation_state": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "maxLength": 16
                                },
                                "language": {
                                  "type": "string",
                                  "maxLength": 32
                                },
                                "quality": {
                                  "type": "string",
                                  "maxLength": 64
                                },
                                "net_content_text": {
                                  "type": "string",
                                  "maxLength": 200
                                },
                                "ingredient_text": {
                                  "type": "string",
                                  "maxLength": 10000
                                },
                                "limitations": {
                                  "type": "string",
                                  "maxLength": 10000
                                },
                                "license": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200
                                },
                                "attribution": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200
                                }
                              }
                            },
                            "provenance": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "nutrients",
                            "servings",
                            "density_g_ml"
                          ]
                        }
                      }
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "ref",
                        "food_revision"
                      ],
                      "not": {
                        "required": [
                          "new_food"
                        ]
                      }
                    },
                    {
                      "required": [
                        "new_food"
                      ],
                      "not": {
                        "required": [
                          "ref"
                        ]
                      }
                    }
                  ]
                }
              },
              "declaration": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/declaration"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "composition": {
                "$ref": "#/$defs/composition"
              },
              "evidence": {
                "type": "object"
              },
              "confirmed": {
                "const": true
              },
              "skip": {
                "type": "boolean"
              },
              "authority": {
                "enum": [
                  "derive_items",
                  "disjoint_aggregate"
                ]
              },
              "conflict_action": {
                "enum": [
                  "skip",
                  "keep_and_add",
                  "block"
                ]
              },
              "portion_amount": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$"
              },
              "portion_unit": {
                "enum": [
                  "g",
                  "ml",
                  "portion"
                ]
              }
            }
          }
        },
        "plan_identity": {
          "type": "string",
          "format": "uuid"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        }
      },
      "dependentRequired": {
        "plan_identity": [
          "plan_revision"
        ],
        "plan_revision": [
          "plan_identity"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "destination": {
                "enum": [
                  "plan",
                  "consumed",
                  "products",
                  "recipes"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": [
                    "name"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "trace",
            "below_limit"
