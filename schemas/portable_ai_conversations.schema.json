{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/portable_ai_conversations.schema.json",
  "title": "Health Tracker portable AI conversation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ai_conversations"},
    "public_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "created_at", "updated_at", "messages", "tool_calls", "drafts"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"type": "string", "enum": ["active", "archived"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "messages": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_id", "role", "content", "evidence", "provider", "model", "usage", "created_at"],
            "properties": {
              "public_id": {"type": "string", "format": "uuid"},
              "role": {"type": "string", "enum": ["user", "assistant"]},
              "content": {"type": "string", "maxLength": 12000},
              "evidence": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
              "provider": {"type": ["string", "null"], "maxLength": 64},
              "model": {"type": ["string", "null"], "maxLength": 128},
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens"],
                "properties": {
                  "input_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "output_tokens": {"type": ["integer", "null"], "minimum": 0}
                }
              },
              "created_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_id", "request_message_public_id", "tool_name", "result_summary", "evidence", "status", "error_code", "created_at", "completed_at"],
            "properties": {
              "public_id": {"type": "string", "format": "uuid"},
              "request_message_public_id": {"type": "string", "format": "uuid"},
              "tool_name": {"type": "string", "minLength": 1, "maxLength": 96},
              "result_summary": {"type": ["object", "null"]},
              "evidence": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
              "status": {"type": "string", "enum": ["completed", "failed", "rejected"]},
              "error_code": {"type": ["string", "null"], "maxLength": 64},
              "created_at": {"type": "string", "format": "date-time"},
              "completed_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        },
        "drafts": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_id", "message_public_id", "draft_type", "payload", "status", "provenance", "applied_resource", "error_code", "expires_at", "applied_at", "rejected_at", "failed_at", "created_at", "updated_at"],
            "properties": {
              "public_id": {"type": "string", "format": "uuid"},
              "message_public_id": {"type": "string", "format": "uuid"},
              "draft_type": {"type": "string", "enum": ["food_entry", "body_measurement", "workout_entry", "steps_entry"]},
              "payload": {"type": "object"},
              "status": {"type": "string", "enum": ["pending_confirmation", "applied", "rejected", "expired", "failed"]},
              "provenance": {"type": "object"},
              "applied_resource": {
                "type": ["object", "null"],
                "properties": {
                  "type": {"type": "string", "maxLength": 32},
                  "public_ids": {"type": "array", "maxItems": 20, "items": {"type": "string", "format": "uuid"}}
                },
                "required": ["type", "public_ids"],
                "additionalProperties": false
              },
              "error_code": {"type": ["string", "null"], "maxLength": 64},
              "expires_at": {"type": ["string", "null"], "format": "date-time"},
              "applied_at": {"type": ["string", "null"], "format": "date-time"},
              "rejected_at": {"type": ["string", "null"], "format": "date-time"},
              "failed_at": {"type": ["string", "null"], "format": "date-time"},
              "created_at": {"type": "string", "format": "date-time"},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
