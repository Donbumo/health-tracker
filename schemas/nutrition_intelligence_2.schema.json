    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "calculation_method": {
          "const": "decimal_scaled_v1"
        },
        "name": {
          "type": "string",
          "maxLength": 200,
