{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/mobile_progress.schema.json",
  "title": "Mobile progress read contracts 1.0",
  "oneOf": [
    {"$ref": "#/$defs/summary"},
    {"$ref": "#/$defs/exerciseList"},
    {"$ref": "#/$defs/exerciseDetail"}
  ],
  "$defs": {
    "range": {"enum": ["7", "30", "90", "180", "365", "all"]},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "range", "generated_at", "metrics", "comparison", "comparable_load_modes"],
      "properties": {
        "schema_version": {"const": "1.0"}, "range": {"$ref": "#/$defs/range"},
        "generated_at": {"type": "string", "format": "date-time"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "comparison": {"type": ["object", "null"], "additionalProperties": {"$ref": "#/$defs/comparison"}},
        "comparable_load_modes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["sessions", "training_days", "distinct_exercises", "completed_sets", "total_reps", "volume_kg", "volume_partial", "duration_seconds"],
      "properties": {
        "sessions": {"type": "integer", "minimum": 0}, "training_days": {"type": "integer", "minimum": 0},
        "distinct_exercises": {"type": "integer", "minimum": 0}, "completed_sets": {"type": "integer", "minimum": 0},
        "total_reps": {"type": "integer", "minimum": 0}, "volume_kg": {"type": ["string", "null"]},
        "volume_partial": {"type": "boolean"}, "duration_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["change", "percent", "previous"],
      "properties": {"change": {"type": "string"}, "percent": {"type": ["string", "null"]}, "previous": {"type": "string"}}
    },
    "exerciseList": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "range", "items"],
      "properties": {"schema_version": {"const": "1.0"}, "range": {"$ref": "#/$defs/range"}, "items": {"type": "array", "items": {"$ref": "#/$defs/exercise"}}}
    },
    "exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["public_id", "name", "last_performed_at", "session_count", "set_count", "best_load_kg", "best_repetition_set", "volume_kg", "volume_partial", "load_comparable", "load_modes", "trend"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"}, "name": {"type": "string", "minLength": 1},
        "last_performed_at": {"type": ["string", "null"], "format": "date-time"},
        "session_count": {"type": "integer", "minimum": 0}, "set_count": {"type": "integer", "minimum": 0},
        "best_load_kg": {"type": ["string", "null"]},
        "best_repetition_set": {"type": ["object", "null"], "properties": {"reps": {"type": "integer"}, "weight_kg": {"type": "string"}}, "required": ["reps", "weight_kg"], "additionalProperties": false},
        "volume_kg": {"type": ["string", "null"]}, "volume_partial": {"type": "boolean"},
        "load_comparable": {"type": "boolean"}, "load_modes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "trend": {"enum": ["up", "down", "stable", "insufficient_data"]}
      }
    },
    "exerciseDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "range", "exercise", "points", "personal_records", "recent_sessions"],
      "properties": {
        "schema_version": {"const": "1.0"}, "range": {"$ref": "#/$defs/range"}, "exercise": {"$ref": "#/$defs/exercise"},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "personal_records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "recent_sessions": {"type": "array", "maxItems": 10, "items": {"type": "object"}}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "performed_at", "session_public_id", "best_load_kg", "best_reps", "volume_kg", "set_count", "average_rir", "average_rpe", "load_comparable"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "performed_at": {"type": "string", "format": "date-time"},
        "session_public_id": {"type": "string", "format": "uuid"}, "best_load_kg": {"type": ["string", "null"]},
        "best_reps": {"type": ["integer", "null"]}, "volume_kg": {"type": ["string", "null"]}, "set_count": {"type": "integer"},
        "average_rir": {"type": ["string", "null"]}, "average_rpe": {"type": ["string", "null"]}, "load_comparable": {"type": "boolean"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["type", "value", "unit", "date", "session_public_id", "set_index"],
      "properties": {
        "type": {"enum": ["highest_load", "most_reps_at_comparable_load", "highest_set_volume", "highest_session_volume"]},
        "value": {"type": "string"}, "unit": {"enum": ["kg", "reps"]}, "date": {"type": "string", "format": "date"},
        "session_public_id": {"type": "string", "format": "uuid"}, "set_index": {"type": ["integer", "null"]}
      }
    }
  }
}
