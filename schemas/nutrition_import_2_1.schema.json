        },
        "servings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serving"
          },
          "maxItems": 100
        },
        "license": {
          "type": "string",
          "maxLength": 200
        },
        "provenance": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "null",
              "boolean"
            ]
          }
        },
        "catalog_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "catalog_sha256": {
          "type": "string",
