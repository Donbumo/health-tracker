        "unit": {
          "enum": [
            "g",
            "ml",
            "serving"
          ]
        },
        "serving_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
