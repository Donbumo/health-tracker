              "maxLength": 32
            },
            "quality": {
              "type": "string",
              "maxLength": 64
            },
            "net_content_text": {
              "type": "string",
              "maxLength": 200
            },
            "ingredient_text": {
              "type": "string",
              "maxLength": 10000
            },
            "limitations": {
              "type": "string",
              "maxLength": 10000
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "required": [
        "scope",
        "source",
        "revision",
        "name",
        "preparation",
        "basis_amount",
        "basis_unit",
        "nutrients",
        "servings",
