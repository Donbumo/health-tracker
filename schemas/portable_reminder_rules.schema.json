{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/portable_reminder_rules.schema.json",
  "title": "Portable reminder rules record v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "revision", "data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "reminder_rules"},
    "public_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["reminder_type", "goal_public_id", "local_time", "applicable_days", "lead_minutes", "quiet_start", "quiet_end", "quiet_timezone", "snooze_options", "max_per_day", "cooldown_minutes", "enabled", "timezone", "related_public_id"],
      "properties": {
        "reminder_type": {"enum": ["scheduled_workout_upcoming", "scheduled_workout_pending", "log_weight", "log_nutrition", "review_steps", "weekly_summary", "pending_sync_attention", "conflict_attention"]},
        "goal_public_id": {"type": ["string", "null"], "format": "uuid"},
        "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "applicable_days": {"type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 7, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "lead_minutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "quiet_start": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "quiet_end": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "quiet_timezone": {"type": ["string", "null"], "maxLength": 64},
        "snooze_options": {"type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 4, "items": {"enum": [15, 30, 60, "tomorrow"]}},
        "max_per_day": {"type": "integer", "minimum": 1, "maximum": 10},
        "cooldown_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "enabled": {"type": "boolean"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
        "related_public_id": {"type": ["string", "null"], "format": "uuid"}
      }
    }
  }
}
