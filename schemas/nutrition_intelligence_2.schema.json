          "identity",
          "client_event_id",
          "revision",
          "local_date",
          "consumed_at",
          "timezone",
          "recipe_id",
          "meal_order",
          "item_order",
          "snapshot"
        ]
      },
      "maxItems": 1000
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "authority": {
            "enum": [
              "derived",
              "disjoint_aggregate"
            ]
          },
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/$defs/baseline"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "authority",
          "baseline"
        ]
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "type",
    "foods",
    "templates",
    "logs",
    "authorities"
  ],
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "trace",
            "below_limit"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "g",
            "mg",
            "ug",
            "kcal"
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "null",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "state",
        "value",
        "unit"
      ]
    },
    "vector": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "energy",
          "protein",
          "carbohydrate_total",
          "net_carbs",
          "fat",
          "fiber",
          "sugar",
          "sodium",
          "potassium",
          "calcium",
          "iron",
          "magnesium",
          "phosphorus",
          "zinc",
          "vitamin_a_rae",
          "retinol",
          "vitamin_a_re",
          "vitamin_c",
          "vitamin_d",
          "vitamin_e_alpha",
          "vitamin_k1",
          "vitamin_k2",
          "thiamin",
          "riboflavin",
          "niacin",
          "vitamin_b6",
          "vitamin_b12",
          "folate_dfe",
          "folate_food",
          "choline"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
          "maxLength": 80
        },
        "unit": {
          "enum": [
            "g",
            "ml"
          ]
        },
        "provenance": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "null",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "id",
        "label",
        "amount",
        "unit"
      ]
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
