            "ml"
          ]
        },
        "provenance": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "null",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "id",
        "label",
        "amount",
        "unit"
      ]
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string",
