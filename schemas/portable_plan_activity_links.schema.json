{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://health-tracker.local/schemas/portable_plan_activity_links.schema.json",
  "title": "Portable plan activity links record v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "revision", "data"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "plan_activity_links"}, "public_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1},
    "data": {"type": "object", "additionalProperties": false, "required": ["activity_public_id", "schedule_public_id", "state", "evidence"], "properties": {
      "activity_public_id": {"type": "string", "format": "uuid"}, "schedule_public_id": {"type": "string", "format": "uuid"},
      "state": {"enum": ["strong_auto_link", "user_confirmed", "user_rejected"]}, "evidence": {"type": "object"}
    }}
  }
}
