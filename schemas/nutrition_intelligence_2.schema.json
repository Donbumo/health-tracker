        "revision": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "maxLength": 200
        },
        "preparation": {
          "type": "string",
          "maxLength": 200
        },
        "basis_amount": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
          "maxLength": 80
        },
        "basis_unit": {
          "enum": [
            "g",
            "ml"
          ]
        },
        "density_g_ml": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "nutrients": {
          "$ref": "#/$defs/vector"
        },
        "servings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serving"
          },
          "maxItems": 100
        },
        "license": {
          "type": "string",
          "maxLength": 200
        },
        "provenance": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "null",
              "boolean"
            ]
          }
        },
        "catalog_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "scope",
        "source",
        "revision",
        "name",
        "preparation",
        "basis_amount",
        "basis_unit",
        "nutrients",
        "servings",
        "density_g_ml"
      ]
    },
