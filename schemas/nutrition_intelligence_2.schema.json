{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/nutrition_intelligence_2.schema.json",
  "title": "Nutrition Intelligence complete snapshot bundle 2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "type": {
      "const": "nutrition_intelligence"
    },
    "foods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "integer",
            "minimum": 1
          },
          "identity": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "brand": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "nutrition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nutrients": {
                "$ref": "#/$defs/vector"
              },
              "servings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/serving"
                },
                "maxItems": 100
              },
              "density_g_ml": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "nutrients",
              "servings",
              "density_g_ml"
            ]
          }
        },
        "required": [
          "source_id",
          "identity",
          "revision",
          "name",
          "brand",
          "nutrition"
        ]
      },
      "maxItems": 1000
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "integer",
            "minimum": 1
          },
          "identity": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "snapshot": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "required": [
          "source_id",
          "identity",
          "revision",
          "name",
          "snapshot"
        ]
      },
      "maxItems": 1000
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identity": {
            "type": "string",
            "format": "uuid"
          },
          "client_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "local_date": {
            "type": "string",
            "format": "date"
          },
          "consumed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "timezone": {
            "type": "string",
            "maxLength": 200
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "meal_order": {
            "type": "integer",
            "minimum": 1
          },
          "item_order": {
            "type": "integer",
            "minimum": 1
          },
          "snapshot": {
            "$ref": "#/$defs/snapshot"
          }
