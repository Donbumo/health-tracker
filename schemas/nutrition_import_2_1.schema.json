        },
        "basis_amount": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
          "maxLength": 80
        },
        "basis_unit": {
          "enum": [
            "g",
