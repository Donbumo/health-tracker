{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/mobile_planning.schema.json",
  "title": "Mobile planning read models",
  "oneOf": [
    {"$ref": "#/$defs/exercise_catalog"},
    {"$ref": "#/$defs/plan_list"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/plan_mutation"},
    {"$ref": "#/$defs/workout_mutation"},
    {"$ref": "#/$defs/schedule_mutation"},
    {"$ref": "#/$defs/delete_mutation"}
  ],
  "$defs": {
    "nullable_decimal": {
      "type": ["string", "null"],
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "exercise_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "has_more", "available_filters"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/catalog_item"}},
        "next_cursor": {"type": ["string", "null"]},
        "has_more": {"type": "boolean"},
        "available_filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["muscle_group", "equipment"],
          "properties": {
            "muscle_group": {"type": "boolean"},
            "equipment": {"type": "boolean"}
          }
        }
      }
    },
    "catalog_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "name", "aliases", "custom", "archived", "selectable", "muscle_group", "equipment", "preferred_load_mode", "preferred_unit"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "custom": {"type": "boolean"},
        "archived": {"type": "boolean"},
        "selectable": {"type": "boolean"},
        "muscle_group": {"type": ["string", "null"]},
        "equipment": {"type": ["string", "null"]},
        "preferred_load_mode": {"type": ["string", "null"]},
        "preferred_unit": {"type": ["string", "null"]}
      }
    },
    "plan_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/plan"}}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "name", "description", "status", "revision", "active_version_id", "active_version", "workout_count", "workouts", "created_at", "updated_at", "archived_at"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": ["string", "null"], "maxLength": 5000},
        "status": {"enum": ["active", "archived"]},
        "revision": {"type": "integer", "minimum": 1},
        "active_version_id": {"type": ["string", "null"], "format": "uuid"},
        "active_version": {"type": ["integer", "null"], "minimum": 1},
        "workout_count": {"type": "integer", "minimum": 0, "maximum": 728},
        "workouts": {"type": ["array", "null"], "items": {"$ref": "#/$defs/workout"}},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "archived_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "name", "notes", "position", "exercises", "estimated_duration_seconds", "revision", "created_at", "updated_at"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "notes": {"type": ["string", "null"], "maxLength": 5000},
        "position": {"type": "integer", "minimum": 1, "maximum": 728},
        "exercises": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/prescribed_exercise"}},
        "estimated_duration_seconds": {"type": ["integer", "null"], "minimum": 0},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "plan_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "status", "revision", "active_version", "updated_at"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["active", "archived"]},
        "revision": {"type": "integer", "minimum": 1},
        "active_version": {"type": ["integer", "null"], "minimum": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "workout_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "plan_id", "position", "revision", "plan_revision", "updated_at"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "plan_id": {"type": "string", "format": "uuid"},
        "position": {"type": "integer", "minimum": 1, "maximum": 728},
        "revision": {"type": "integer", "minimum": 1},
        "plan_revision": {"type": "integer", "minimum": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "schedule_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "status", "revision", "scheduled_for_date", "timezone"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "status": {"enum": ["planned", "downloaded", "active", "completed", "aborted", "cancelled"]},
        "revision": {"type": "integer", "minimum": 1},
        "scheduled_for_date": {"type": "string", "format": "date"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "delete_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_id", "deleted", "revision"],
      "properties": {
        "public_id": {"type": "string", "format": "uuid"},
        "deleted": {"const": true},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "prescribed_exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exercise_order", "name", "sets"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "exercise_id": {"type": ["string", "null"], "format": "uuid"},
        "exercise_order": {"type": "integer", "minimum": 1, "maximum": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "notes": {"type": "string", "maxLength": 2000},
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/prescribed_set"}
        }
      }
    },
    "prescribed_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set_number", "load_mode", "load_unit"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "set_number": {"type": "integer", "minimum": 1, "maximum": 100},
        "reps": {"type": "integer", "minimum": 1},
        "reps_min": {"type": "integer", "minimum": 1},
        "reps_max": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "distance_m": {"$ref": "#/$defs/positive_decimal"},
        "weight_kg": {"$ref": "#/$defs/non_negative_decimal"},
        "load_value": {"$ref": "#/$defs/non_negative_decimal"},
        "load_unit": {"enum": ["kg", "lb"]},
        "load_mode": {"enum": ["direct_total", "per_side", "bar_plus_per_side", "machine_initial_total", "machine_initial_per_side", "machine_external_per_side_initial_total", "selector_stack", "dumbbell_each", "bodyweight", "bodyweight_plus", "assistance", "duration_distance"]},
        "load_details": {"type": "object"},
        "rir": {"$ref": "#/$defs/rir"},
        "rpe": {"$ref": "#/$defs/rpe"},
        "notes": {"type": "string", "maxLength": 2000},
        "target": {"type": "string", "maxLength": 200},
        "rest_seconds": {"type": "integer", "minimum": 0}
      },
      "anyOf": [
        {"required": ["reps"]},
        {"required": ["reps_min", "reps_max"]},
        {"required": ["duration_seconds"]},
        {"required": ["distance_m"]}
      ],
      "dependentRequired": {
        "reps_min": ["reps_max"],
        "reps_max": ["reps_min"]
      }
    },
    "non_negative_decimal": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      ]
    },
    "positive_decimal": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "string", "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$"}
      ]
    },
    "rir": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 20},
        {"type": "string", "pattern": "^(?:[0-9](?:\\.[0-9]+)?|1[0-9](?:\\.[0-9]+)?|20(?:\\.0+)?)$"}
      ]
    },
    "rpe": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 10},
        {"type": "string", "pattern": "^(?:[0-9](?:\\.[0-9]+)?|10(?:\\.0+)?)$"}
      ]
    }
  }
}
