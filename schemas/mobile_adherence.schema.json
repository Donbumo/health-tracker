{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/mobile_adherence.schema.json",
  "title": "Descriptive adherence summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "status", "items", "summary"],
  "properties": {
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "days", "timezone"],
      "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}, "days": {"enum": [7, 30, 90]}, "timezone": {"type": "string", "maxLength": 64}}
    },
    "status": {"enum": ["no_configured", "available"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["goal", "status", "completed", "expected", "percentage", "summary", "comparison", "details"],
        "properties": {
          "goal": {"$ref": "mobile_goals.schema.json#/$defs/goal"},
          "status": {"enum": ["no_configured", "insufficient_data", "on_track", "partially_complete", "completed", "missed", "paused"]},
          "completed": {"type": "integer", "minimum": 0},
          "expected": {"type": "integer", "minimum": 0},
          "percentage": {"type": ["number", "null"], "minimum": 0},
          "summary": {"type": "string", "maxLength": 200},
          "comparison": {"type": "object"},
          "details": {"type": "object"}
        }
      }
    },
    "summary": {"type": "string", "maxLength": 200}
  }
}
