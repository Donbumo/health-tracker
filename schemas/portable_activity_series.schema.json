{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://health-tracker.local/schemas/portable_activity_series.schema.json",
  "title": "Portable activity series record v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "data"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "activity_series"}, "public_id": {"type": "string", "format": "uuid"},
    "data": {"type": "object", "additionalProperties": false, "required": ["activity_public_id", "format", "fields", "samples"], "properties": {
      "activity_public_id": {"type": "string", "format": "uuid"}, "format": {"const": "activity-series-v1"},
      "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "samples": {"type": "array", "maxItems": 2000, "items": {"type": "object", "additionalProperties": {"type": "number"}}}
    }}
  }
}
