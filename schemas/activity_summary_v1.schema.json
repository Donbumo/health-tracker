{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/activity_summary_v1.schema.json",
  "title": "Health Tracker Activity Summary v1",
  "type": "object",
  "additionalProperties": {"$ref": "#/$defs/metric"},
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "provenance"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 16},
        "provenance": {"enum": ["source_provided", "derived_exact", "derived_estimate", "unavailable"]}
      }
    }
  }
}
