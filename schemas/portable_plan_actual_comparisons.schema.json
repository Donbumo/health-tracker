{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://health-tracker.local/schemas/portable_plan_actual_comparisons.schema.json",
  "title": "Portable plan actual comparisons record v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "data"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "plan_actual_comparisons"}, "public_id": {"type": "string", "format": "uuid"},
    "data": {"type": "object", "additionalProperties": false, "required": ["plan_activity_link_public_id", "status", "activity_revision", "plan_revision", "comparison"], "properties": {
      "plan_activity_link_public_id": {"type": "string", "format": "uuid"}, "status": {"enum": ["completed", "partially_completed", "deviated", "insufficient_data", "not_comparable"]},
      "activity_revision": {"type": "integer", "minimum": 1}, "plan_revision": {"type": "integer", "minimum": 1}, "comparison": {"type": "object"}
    }}
  }
}
