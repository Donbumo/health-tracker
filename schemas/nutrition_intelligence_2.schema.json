                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "amount",
            "unit",
            "mass_g"
          ]
        },
        "contribution": {
          "$ref": "#/$defs/vector"
        }
      },
      "required": [
        "food",
        "amount",
        "unit",
        "serving_id",
        "normalized",
        "contribution"
      ]
    },
    "summary_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "g",
            "mg",
            "ug",
            "kcal"
          ]
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "known_weight": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "total_weight": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_method": {
          "const": "mass_weighted_v1"
        },
        "known_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 100
        }
      },
      "required": [
        "value",
        "unit",
        "state",
        "known_weight",
        "total_weight",
        "coverage",
        "coverage_method",
        "known_items",
        "total_items",
        "sources"
      ]
