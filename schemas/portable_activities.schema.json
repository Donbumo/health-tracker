{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-tracker.local/schemas/portable_activities.schema.json",
  "title": "Portable activities record v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "public_id", "revision", "data"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_type": {"const": "activities"},
    "public_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["discipline", "original_type", "started_at", "environment", "status", "source_format", "metrics_provenance", "warnings", "route"],
      "allOf": [
        {
          "if": {
            "properties": {"source_type": {"const": "external_provider"}},
            "required": ["source_type"]
          },
          "then": {
            "required": ["provider", "external_account_id", "external_resource_id"],
            "properties": {
              "provider": {"type": "string", "minLength": 1, "maxLength": 32},
              "external_account_id": {"type": "string", "format": "uuid"},
              "external_resource_id": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        }
      ],
      "properties": {
        "discipline": {"enum": ["cycling", "running", "walking", "hiking", "strength", "indoor_cycling", "other", "unknown"]},
        "subtype": {"type": ["string", "null"], "maxLength": 64}, "original_type": {"type": "string", "maxLength": 128},
        "title": {"type": ["string", "null"], "maxLength": 200}, "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"}, "timezone": {"type": ["string", "null"], "maxLength": 64},
        "utc_offset_minutes": {"type": ["integer", "null"], "minimum": -840, "maximum": 840}, "local_date": {"type": ["string", "null"], "format": "date"},
        "duration_seconds": {"type": ["integer", "null"], "minimum": 0}, "elapsed_time_seconds": {"type": ["integer", "null"], "minimum": 0},
        "moving_time_seconds": {"type": ["integer", "null"], "minimum": 0}, "distance_meters": {"type": ["number", "string", "null"]},
        "calories_kcal": {"type": ["number", "string", "null"]}, "ascent_meters": {"type": ["number", "string", "null"]}, "descent_meters": {"type": ["number", "string", "null"]},
        "average_heart_rate_bpm": {"type": ["integer", "null"]}, "maximum_heart_rate_bpm": {"type": ["integer", "null"]},
        "average_cadence_rpm": {"type": ["number", "string", "null"]}, "maximum_cadence_rpm": {"type": ["number", "string", "null"]},
        "average_speed_mps": {"type": ["number", "string", "null"]}, "maximum_speed_mps": {"type": ["number", "string", "null"]},
        "average_power_watts": {"type": ["integer", "null"]}, "maximum_power_watts": {"type": ["integer", "null"]},
        "environment": {"enum": ["indoor", "outdoor", "unknown"]}, "status": {"enum": ["imported", "archived"]},
        "source_format": {"enum": ["fit", "gpx", "tcx", "json", "csv", "unknown"]}, "source_application": {"type": ["string", "null"], "maxLength": 128},
        "source_type": {"enum": ["uploaded", "device_sync", "external_provider", null]},
        "provider": {"type": ["string", "null"], "maxLength": 32},
        "external_account_id": {"type": ["string", "null"], "format": "uuid"},
        "external_resource_id": {"type": ["string", "null"], "maxLength": 128},
        "source_device": {"type": ["string", "null"], "maxLength": 128}, "metrics_provenance": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string", "maxLength": 300}},
        "route": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
